# --- the ones that actually matter for this repo ---

# Footage. GitHub rejects files over 100 MB and a single 120 fps clip will
# blow past that. Keep clips local; publish a short GIF in docs/ instead.
*.mp4
*.mov
*.MOV
*.avi
*.mkv

# Model weights. best.pt is a build artifact of your dataset, not source.
*.pt
*.pth
*.onnx
*.mlpackage/
runs/

# Datasets exported from Roboflow
datasets/
*.zip

# Generated by the pipeline
out/
sample/
rim.json
court.txt
*.csv

